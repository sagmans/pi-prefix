  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.84.4 <0.85.0",
    "@earendil-works/pi-tui": ">=0.84.4 <0.85.0",
    "@types/node": "^24.0.0",
