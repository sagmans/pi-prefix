#!/bin/sh
# Runs typecheck, tests, Biome, the dependency audits and a pack dry-run on
# each pushed commit. The Pi host compatibility matrix runs in 30-pi-compat.
set -eu

# A stalled package tool must stop the push and identify its step.
INSTALL_TIMEOUT_SECONDS=300
SUITE_TIMEOUT_SECONDS=600
NETWORK_TIMEOUT_SECONDS=120

checks() {
	run_step 'npm typecheck' "$SUITE_TIMEOUT_SECONDS" npm run typecheck || return 1
	run_step 'npm test' "$SUITE_TIMEOUT_SECONDS" npm test || return 1
	run_step 'npm lint' "$SUITE_TIMEOUT_SECONDS" npm run lint || return 1
	# Dependency gates: known high or critical advisories, and registry
	# signatures plus provenance of every installed package.
	run_step 'npm audit' "$NETWORK_TIMEOUT_SECONDS" npm audit --audit-level=high || return 1
	run_step 'npm audit signatures' "$NETWORK_TIMEOUT_SECONDS" npm audit signatures || return 1
	run_step 'npm pack dry run' "$SUITE_TIMEOUT_SECONDS" npm pack --dry-run >/dev/null || return 1
}

# Helpers (staged_git, pushed_shas, at_sha, darwin_only) from .githooks/lib.
# shellcheck source=/dev/null
. "${HOOK_HELPERS:?run from .githooks (scripts/setup-hooks)}"

top=$(git rev-parse --show-toplevel)
# A temporary worktree has no dependencies: install them from that commit's
# lockfile (never resolved; npm skips lifecycle scripts, pnpm runs only the
# builds allowed in pnpm-workspace.yaml). In place, the clone's install is used.
install_deps() {
	[ "$(pwd -P)" != "$(CDPATH='' cd -- "$top" && pwd -P)" ] || return 0
	if [ -f pnpm-lock.yaml ]; then
		run_step 'pnpm install' "$INSTALL_TIMEOUT_SECONDS" pnpm install --frozen-lockfile >/dev/null || return 1
	elif [ -f package-lock.json ]; then
		run_step 'npm ci' "$INSTALL_TIMEOUT_SECONDS" npm ci --ignore-scripts --no-audit --no-fund >/dev/null || return 1
	fi
}

# at_sha runs this with set -e off, so every step returns on failure.
run_at() {
	install_deps || return 1
	checks || return 1
}

# Each pushed commit is tested as pushed: in place when it is a clean HEAD,
# otherwise in a temporary worktree. A for loop, never `| while`, so a failure
# blocks the push.
shas=$(pushed_shas <"$HOOK_STDIN_FILE") || exit 1
for pp_commit in $shas; do
	echo "pre-push: $(basename -- "$0"): checking $pp_commit" >&2
	if ! at_sha "$pp_commit" run_at; then
		echo "pre-push: $(basename -- "$0"): checks failed for $pp_commit" >&2
		exit 1
	fi
done
